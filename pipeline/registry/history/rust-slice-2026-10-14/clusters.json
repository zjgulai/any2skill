          "anchors": [
            "ch04-03-slices#h2-1"
          ],
          "rationale": "该对象描述通过多个彼此无关的开始/结束索引维护数据范围的问题，这是切片要解决的同一问题空间：用切片内聚引用和长度，避免多个索引状态不同步。"
        },
        {
          "unitId": "ch04-03-slices-u2",
          "name": "字符串切片与用法",
          "objectIds": [
            "CH04-03-SLICES-H3-1-CONCEPT-01",
            "CH04-03-SLICES-H3-1-ENGINEERINGRULE-02",
            "CH04-03-SLICES-H4-1-CONCEPT-01",
