    {
      "fileKey": "ch04-02-references-and-borrowing",
      "inputHash": "sha256:5b2a7feaa9ff49b87ece8120661a2de93fac778dff1e72b72e22c7a1074097c8",
      "status": "proposed",
      "createdAt": "2026-10-14T02:41:55.167Z",
      "modelId": "deepseek-v4-pro",
      "units": [
        {
          "unitId": "ch04-02-references-and-borrowing-u1",
          "name": "引用与借用语义",
          "objectIds": [
            "CH04-02-REFERENCES-AND-BORROWING-H2-1-CONCEPT-01",
            "CH04-02-REFERENCES-AND-BORROWING-H2-1-CONCEPT-02"
          ],
          "anchors": [
            "ch04-02-references-and-borrowing#h2-1"
          ],
          "rationale": "这两个对象共同定义引用和借用的基本概念：引用由 & 语法创建、指向值但不拥有它，因此停止使用时不会丢弃所指向的值；借用是创建引用的行为，用完必须归还。它们回答同一基础问题：引用是什么、借用是什么。"
        },
        {
          "unitId": "ch04-02-references-and-borrowing-u2",
          "name": "别名与可变性限制",
          "objectIds": [
            "CH04-02-REFERENCES-AND-BORROWING-H3-1-ENGINEERINGRULE-01",
            "CH04-02-REFERENCES-AND-BORROWING-H3-1-ENGINEERINGRULE-02",
            "CH04-02-REFERENCES-AND-BORROWING-H3-3-ENGINEERINGRULE-01"
          ],
          "anchors": [
            "ch04-02-references-and-borrowing#h3-1",
            "ch04-02-references-and-borrowing#h3-3"
          ],
          "rationale": "这些对象围绕同一规则空间：拥有不可变引用时不能拥有可变引用；Rust 不编译存在数据竞争的代码；同一时间要么只有一个可变引用，要么只有多个不可变引用。它们共同回答同一问题：程序中同时可以持有哪类引用，以及为什么有这种限制。"
        },
        {
          "unitId": "ch04-02-references-and-borrowing-u3",
          "name": "悬垂引用与有效性",
          "objectIds": [
            "CH04-02-REFERENCES-AND-BORROWING-H3-2-CONCEPT-01",
            "CH04-02-REFERENCES-AND-BORROWING-H3-2-ENGINEERINGRULE-02",
            "CH04-02-REFERENCES-AND-BORROWING-H3-3-ENGINEERINGRULE-02"
          ],
          "anchors": [
            "ch04-02-references-and-borrowing#h3-2",
            "ch04-02-references-and-borrowing#h3-3"
          ],
          "rationale": "这些对象共同解释悬垂指针的定义、编译器如何保证数据不会在引用之前离开作用域，以及引用必须总是有效这一总规则。它们回答同一问题：引用如何避免指向已经失效的内存。"
        }
      ],
      "skills": [
        {
          "skillId": "ch04-02-references-and-borrowing-s1",
          "name": "Rust 引用与借用规则",
          "trigger": "当需要安全地让多个变量访问同一数据，或需要理解、编写、排查涉及引用、可变性、数据竞争与悬垂引用的 Rust 代码时，使用此候选。",
          "unitIds": [
            "ch04-02-references-and-borrowing-u1",
            "ch04-02-references-and-borrowing-u2",
            "ch04-02-references-and-borrowing-u3"
          ],
          "objectIds": [
            "CH04-02-REFERENCES-AND-BORROWING-H2-1-CONCEPT-01",
            "CH04-02-REFERENCES-AND-BORROWING-H2-1-CONCEPT-02",
            "CH04-02-REFERENCES-AND-BORROWING-H3-1-ENGINEERINGRULE-01",
            "CH04-02-REFERENCES-AND-BORROWING-H3-1-ENGINEERINGRULE-02",
            "CH04-02-REFERENCES-AND-BORROWING-H3-3-ENGINEERINGRULE-01",
            "CH04-02-REFERENCES-AND-BORROWING-H3-2-CONCEPT-01",
            "CH04-02-REFERENCES-AND-BORROWING-H3-2-ENGINEERINGRULE-02",
            "CH04-02-REFERENCES-AND-BORROWING-H3-3-ENGINEERINGRULE-02"
          ],
          "rationale": "这三个单元面向同一批使用场景：在实际 Rust 代码中使用引用与借用时，需要同时理解引用的基本语义、别名与可变性限制，以及悬垂引用防护，才能正确理解借用检查器并保证内存安全。"
        }
      ],
