      "status": "proposed",
      "createdAt": "2026-10-14T02:40:11.081Z",
      "modelId": "deepseek-v4-pro",
      "units": [
        {
          "unitId": "ch04-01-what-is-ownership-u1",
          "name": "所有权核心与作用域",
          "objectIds": [
            "CH04-01-WHAT-IS-OWNERSHIP-H2-1-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H2-1-ENGINEERINGRULE-02",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-1-ENGINEERINGRULE-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-2-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-2-ENGINEERINGRULE-02"
          ],
          "anchors": [
            "ch04-01-what-is-ownership#h2-1",
            "ch04-01-what-is-ownership#h3-1",
            "ch04-01-what-is-ownership#h3-2"
          ],
          "rationale": "这些对象共同回答所有权系统是什么、值在栈/堆上的放置约束、唯一所有者规则，以及作用域如何决定变量的有效范围；它们是理解后续移动、复制和清理规则的前提。"
        },
        {
          "unitId": "ch04-01-what-is-ownership-u2",
          "name": "堆 String 与内存回收",
          "objectIds": [
            "CH04-01-WHAT-IS-OWNERSHIP-H3-3-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-3-ENGINEERINGRULE-02",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-4-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-4-CONCEPT-02"
          ],
          "anchors": [
            "ch04-01-what-is-ownership#h3-3",
            "ch04-01-what-is-ownership#h3-4"
          ],
          "rationale": "这些对象围绕堆上数据如何安全回收：String 是堆分配的例子，内存回收失败说明需要精确释放，drop 则描述 Rust 在作用域结束时的自动清理机制。"
        },
        {
          "unitId": "ch04-01-what-is-ownership-u3",
          "name": "赋值移动与深拷贝",
          "objectIds": [
            "CH04-01-WHAT-IS-OWNERSHIP-H4-1-ENGINEERINGRULE-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H4-1-ENGINEERINGRULE-02",
            "CH04-01-WHAT-IS-OWNERSHIP-H4-2-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-6-CONCEPT-01"
          ],
          "anchors": [
            "ch04-01-what-is-ownership#h4-1",
            "ch04-01-what-is-ownership#h4-2",
            "ch04-01-what-is-ownership#h3-6"
          ],
          "rationale": "这些对象解释赋值时数据如何转移：赋值移动后旧变量失效、Rust 不自动深拷贝、clone 显式深拷贝，以及所有权移动的总体模式；它们都围绕移动与深拷贝这一同一问题空间。"
        },
        {
          "unitId": "ch04-01-what-is-ownership-u4",
          "name": "Copy trait 规则",
          "objectIds": [
            "CH04-01-WHAT-IS-OWNERSHIP-H4-3-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H4-3-ENGINEERINGRULE-02"
          ],
          "anchors": [
            "ch04-01-what-is-ownership#h4-3"
          ],
          "rationale": "这两个对象共同规定什么样的类型在赋值后旧变量仍可用：Copy trait 适用于栈上类型，而 Drop 与 Copy 互斥；它们解决栈上值可复制而堆上值移动的规则边界。"
        },
        {
          "unitId": "ch04-01-what-is-ownership-u5",
          "name": "所有权与函数参数",
          "objectIds": [
            "CH04-01-WHAT-IS-OWNERSHIP-H3-5-CONCEPT-01",
            "CH04-01-WHAT-IS-OWNERSHIP-H3-5-ENGINEERINGRULE-02"
          ],
          "anchors": [
            "ch04-01-what-is-ownership#h3-5"
          ],
          "rationale": "两者说明函数传值在语义上类似赋值，会发生移动或复制，并指出在传值后继续使用已移动变量会触发编译错误；它们共同回答函数调用如何影响所有权。"
        }
      ],
      "skills": [
        {
          "skillId": "ch04-01-what-is-ownership-s1",
          "name": "Rust 所有权基础",
          "trigger": "当需要理解 Rust 如何通过所有权、作用域、堆栈数据和移动/复制规则在编译期管理内存，或排查变量在赋值、函数传参后不可用等编译错误时使用。",
          "unitIds": [
